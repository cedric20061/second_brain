{
  "name": "wxt-react-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "cp node_modules/onnxruntime-web/dist/*.wasm public/wasm/ 2>/dev/null || mkdir -p public/wasm && cp node_modules/onnxruntime-web/dist/*.wasm public/wasm/"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@electric-sql/pglite-pgvector": "^0.0.4",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "cytoscape": "^3.34.3",
    "dompurify": "^3.4.11",
    "graphology": "^0.26.0",
    "ml-kmeans": "^7.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/cytoscape": "^3.31.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
